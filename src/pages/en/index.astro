            <circle cx="320" cy="206" r="2"/><circle cx="336" cy="206" r="2"/><circle cx="352" cy="206" r="2"/><circle cx="368" cy="206" r="2"/>
            <circle cx="320" cy="222" r="2"/><circle cx="336" cy="222" r="2"/><circle cx="352" cy="222" r="2"/><circle cx="368" cy="222" r="2"/>
            <circle cx="320" cy="238" r="2"/><circle cx="336" cy="238" r="2"/><circle cx="352" cy="238" r="2"/><circle cx="368" cy="238" r="2"/>
          </g>
        </g>
        <rect class="b b2 c-ember" x="176" y="300" width="112" height="110" rx="14"/>
        <rect class="b b3 c-slate" x="176" y="120" width="112" height="168" rx="14"/>
        <rect class="stem c-ink" x="40" y="200" width="120" height="210"/>
        <circle class="b dot c-sig" cx="100" cy="122" r="58"/>
      </svg>
    </div>

    <div class="trust">
      <p data-i="trust.label">Ils m'ont fait confiance</p>
      <ul>
        <li>Desjardins</li>
