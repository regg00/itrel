<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>itrel — Architecture infonuagique et IA</title>
<meta name="description" content="itrel, Régis Tremblay Lefrançois : architecte infonuagique et DevOps. Infrastructure Azure, Kubernetes, Terraform et sécurité pour des projets d'IA qui tiennent en production.">
<meta name="theme-color" content="#0E1A2B">
<meta property="og:title" content="itrel — L'IA a besoin de fondations solides">
<meta property="og:description" content="Architecture infonuagique, DevOps et infrastructure pour l'IA. Lévis, Québec.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='28' fill='%230E1A2B'/%3E%3Ccircle cx='50' cy='27' r='10' fill='%23FF6B35'/%3E%3Crect x='40' y='44' width='20' height='38' fill='%23F5F4EF'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono&display=swap">
<style is:global>
:root{
  --paper:#0E1A2B;--surface:#16243A;--ink:#F5F4EF;--slate:#A7B0BD;--line:#2A3A52;
  --signal:#FF6B35;--on-signal:#0E1A2B;--ember:#FF8A5C;--ember-solid:#C2410C;
  --font-display:"Space Grotesk","IBM Plex Sans",system-ui,sans-serif;
  --font-sans:"IBM Plex Sans",system-ui,sans-serif;
  --font-mono:"IBM Plex Mono",ui-monospace,monospace;
  --radius-sm:6px;--radius-md:14px;--radius-lg:28px;
  color-scheme:dark;box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font:400 16px/24px var(--font-sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit}
:focus-visible{outline:2px solid var(--signal);outline-offset:3px;border-radius:4px}
.wrap{max-width:1180px;margin:0 auto;padding:0 clamp(20px,5vw,56px)}

/* header */
.bar{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:24px 0}
.lockup{display:flex;align-items:center;gap:6px;text-decoration:none;font:700 24px/1 var(--font-display);letter-spacing:-.045em}
.lockup svg{width:18px;height:18px}
.nav{display:flex;align-items:center;gap:24px}
.nav a.link{font-size:14px;color:var(--slate);text-decoration:none}
.nav a.link:hover{color:var(--ink)}
.lang{display:flex;border:1px solid var(--line);border-radius:var(--radius-sm);overflow:hidden}
.lang button{all:unset;cursor:pointer;font:400 13px/1 var(--font-mono);padding:8px 10px;color:var(--slate)}
.lang button[aria-pressed="true"]{background:var(--ink);color:var(--paper)}
.lang button:focus-visible{outline:2px solid var(--signal);outline-offset:-2px}
.cta-sm{font-size:14px;text-decoration:none;padding:10px 16px;border-radius:var(--radius-md);background:var(--signal);color:var(--on-signal);font-weight:500}

/* hero */
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;min-height:calc(100svh - 170px);padding:24px 0 48px}
.who{font:400 14px/20px var(--font-mono);color:var(--slate);margin:0 0 20px}
h1{font:700 clamp(44px,6.4vw,86px)/.95 var(--font-display);letter-spacing:-.045em;margin:0 0 24px;max-width:11ch}
.lede{color:var(--slate);font-size:18px;line-height:28px;max-width:40ch;margin:0 0 32px}
.ctas{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;min-height:52px;padding:0 26px;border-radius:var(--radius-md);font:500 16px/1 var(--font-sans);text-decoration:none;transition:transform .25s cubic-bezier(.34,1.8,.5,1)}
.btn:hover{transform:translateY(-3px)}
.btn.primary{background:var(--signal);color:var(--on-signal)}
.btn.ghost{border:1px solid var(--line)}
.copy>*{opacity:0;animation:up .8s cubic-bezier(.2,.8,.3,1) forwards}
.copy>*:nth-child(1){animation-delay:2.4s}.copy>*:nth-child(2){animation-delay:2.5s}.copy>*:nth-child(3){animation-delay:2.65s}.copy>*:nth-child(4){animation-delay:2.8s}

.stage{width:100%;max-width:500px;justify-self:end;overflow:visible}
.stage .b{transform-box:fill-box;transform-origin:50% 100%;transform:translateY(-120vh)}
.b1{animation:fall 1s linear .2s forwards}
.b2{animation:fall 1s linear .45s forwards}
.b3{animation:fall 1s linear .7s forwards}
.stage .stem{transform-box:fill-box;transform-origin:50% 100%;transform:scaleY(0);animation:rise .85s cubic-bezier(.2,.8,.3,1) 1.15s forwards}
.dot{animation:fall 1.2s linear 1.65s forwards}
.grid-dots circle{fill:var(--slate);opacity:.55}
.c-ink{fill:var(--ink)}.c-sig{fill:var(--signal)}.c-slate{fill:#3A4A63}.c-ember{fill:var(--ember-solid)}.c-tint{fill:var(--surface)}

/* trust strip */
.trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:24px 0;display:flex;align-items:center;gap:16px 40px;flex-wrap:wrap}
.trust p{margin:0;font-size:14px;color:var(--slate)}
.trust ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:12px 36px}
.trust li{font:700 20px/1 var(--font-display);letter-spacing:-.02em;color:var(--ink);opacity:.82}

/* stats */
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:88px 0 0}
.stat b{display:block;font:700 clamp(48px,6vw,72px)/1 var(--font-display);letter-spacing:-.04em}
.stat b i{font-style:normal;color:var(--signal)}
.stat span{display:block;color:var(--slate);margin-top:8px;max-width:24ch}

/* sections */
section{padding:112px 0}
.sec-title{font:700 clamp(30px,4vw,48px)/1.05 var(--font-display);letter-spacing:-.03em;margin:0 0 16px;max-width:20ch}
.sec-sub{color:var(--slate);font-size:18px;line-height:28px;margin:0 0 56px;max-width:52ch}

/* pipeline */
.pipe{position:relative;display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.pipe::before{content:"";position:absolute;left:10%;right:10%;top:28px;height:2px;background:var(--line)}
.pulse{position:absolute;top:22px;left:10%;width:14px;height:14px;border-radius:50%;background:var(--signal);box-shadow:0 0 0 6px rgba(255,107,53,.18);animation:travel 4.5s cubic-bezier(.6,0,.4,1) infinite}
.step{position:relative;text-align:center}
.node{width:58px;height:58px;margin:0 auto 16px;border-radius:50%;background:var(--paper);border:2px solid var(--line);display:grid;place-items:center}
.node svg{width:24px;height:24px;stroke:var(--ink);fill:none;stroke-width:1.8}
.step:last-child .node{border-color:var(--signal)}
.step b{display:block;font:500 17px/24px var(--font-display)}
.step span{display:block;color:var(--slate);font-size:14px;line-height:20px;margin-top:4px}
.base{margin-top:40px;padding:16px 20px;border:1px dashed var(--line);border-radius:var(--radius-md);display:flex;gap:12px 24px;flex-wrap:wrap;align-items:center;justify-content:center;color:var(--slate);font-size:14px}
.base strong{color:var(--ink);font-weight:500}
.base code{font:400 13px/1 var(--font-mono);color:var(--ink);background:var(--surface);padding:6px 8px;border-radius:var(--radius-sm)}

/* services */
.svc{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.svc article{background:var(--surface);border-radius:var(--radius-md);padding:32px;border:1px solid var(--line)}
.svc article.lead{background:var(--signal);color:var(--on-signal);border-color:var(--signal)}
.svc article.lead p{color:var(--on-signal)}
.svc h3{font:500 26px/32px var(--font-display);letter-spacing:-.01em;margin:0 0 8px}
.svc p{color:var(--slate);margin:0;max-width:44ch}

/* mandates */
.cases{display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:1px solid var(--ink)}
.case{padding:32px 32px 32px 0;border-bottom:1px solid var(--line)}
.case:nth-child(even){padding:32px 0 32px 32px;border-left:1px solid var(--line)}
.client{font-size:14px;color:var(--ember);font-weight:500;margin:0 0 12px}
.case h3{font:500 24px/30px var(--font-display);letter-spacing:-.01em;margin:0 0 16px;max-width:26ch}
.tags{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
.tags li{font:400 12px/1 var(--font-mono);padding:6px 8px;border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--slate)}

/* certs */
.certs{display:flex;flex-wrap:wrap;gap:12px;margin-top:48px}
.certs a{display:inline-flex;align-items:center;gap:10px;padding:12px 16px;border:1px solid var(--line);border-radius:999px;font-size:14px;text-decoration:none}
.certs a::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--signal)}
.certs a:hover{border-color:var(--ink)}

/* contact */
.contact{text-align:center;padding-bottom:96px}
.contact h2{font:700 clamp(38px,7vw,96px)/.95 var(--font-display);letter-spacing:-.045em;margin:0 0 16px}
.contact p{color:var(--slate);font-size:18px;margin:0 0 32px}
.contact .ctas{justify-content:center}
footer{border-top:1px solid var(--line);padding:24px 0 32px;color:var(--slate);font-size:14px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
footer a{text-decoration:none}footer a:hover{color:var(--ink)}

@keyframes up{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
@keyframes rise{0%{transform:scaleY(0)}55%{transform:scaleY(1.12)}72%{transform:scaleY(.94)}86%{transform:scaleY(1.03)}100%{transform:scaleY(1)}}
@keyframes fall{
  0%{transform:translateY(-120vh);animation-timing-function:cubic-bezier(.55,0,1,.45)}
  40%{transform:translateY(0) scale(1.06,.9);animation-timing-function:cubic-bezier(0,.55,.45,1)}
  46%{transform:translateY(-4%) scale(1)}
  60%{transform:translateY(-14%);animation-timing-function:cubic-bezier(.55,0,1,.45)}
  76%{transform:translateY(0) scale(1.03,.96);animation-timing-function:cubic-bezier(0,.55,.45,1)}
  86%{transform:translateY(-4%) scale(1)}
  95%,100%{transform:translateY(0)}}
@keyframes travel{0%{left:10%;opacity:0}6%{opacity:1}88%{opacity:1}94%,100%{left:calc(90% - 14px);opacity:0}}
@keyframes travel-v{0%{top:22px;opacity:0}6%{opacity:1}88%{opacity:1}94%,100%{top:calc(100% - 36px);opacity:0}}

@media (max-width:900px){
  .nav a.link{display:none}
  .hero{grid-template-columns:1fr;min-height:auto;padding:8px 0 56px;gap:24px}
  .stage{order:-1;justify-self:center;max-width:280px}
  .stats{grid-template-columns:1fr;gap:32px;padding-top:56px}
  .pipe{grid-template-columns:1fr;gap:28px}
  .pipe::before{left:28px;right:auto;top:28px;bottom:28px;width:2px;height:auto}
  .pulse{left:22px;animation-name:travel-v}
  .step{display:grid;grid-template-columns:58px 1fr;gap:16px;text-align:left;align-items:center}
  .node{margin:0}
  .base{justify-content:flex-start}
  .svc,.cases{grid-template-columns:1fr}
  .case,.case:nth-child(even){padding:28px 0;border-left:0}
  section{padding:72px 0}
}
@media (max-width:420px){.cta-sm{display:none}}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-delay:0s!important;animation-iteration-count:1!important}
  .pulse{display:none}
  html{scroll-behavior:auto}
}
</style>
</head>
<body>
<div class="wrap">
  <header class="bar">
    <a class="lockup" href="#" aria-label="itrel">
      <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="23" r="12" fill="#FF6B35"/><rect x="38" y="43" width="24" height="46" fill="#F5F4EF"/></svg>itrel
